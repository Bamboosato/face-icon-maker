{
  "name": "face-icon-maker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "predev": "npm run prepare:assets",
    "dev": "vite",
    "prebuild": "npm run prepare:assets",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run src",
    "prepare:assets": "node scripts/prepare-runtime-assets.mjs",
    "check:assets": "node scripts/check-dist-assets.mjs",
    "test:assets": "node --test scripts/runtime-assets.test.mjs",
    "test:security": "node --test scripts/security-audit-policy.test.mjs scripts/security-audit.test.mjs",
    "audit:security": "node scripts/security-audit.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@litertjs/core": "^2.5.2",
    "@mediapipe/tasks-vision": "^0.10.35",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-image-crop": "^11.1.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@webgpu/types": "^0.1.71",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  }
}
